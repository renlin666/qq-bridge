{
  "id": "social-memory",
  "version": "1.6.0",
  "apiVersion": 1,
  "entry": "./index.js",
  "capabilities": [
    "messages.read",
    "storage.sqlite",
    "memory.context",
    "memory.policy",
    "memory.legacy",
    "ark.rank",
    "ark.embed",
    "scheduler",
    "admin.local"
  ],
  "tools": [
    {
      "name": "qq_social_memory_query",
      "description": "按当前授权会话检索关键词索引，可按主题筛选；observation是未确认观察，不作事实或评分依据；正文按需读取。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "messageId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "当前会话收到的原消息 messageId/seq，绑定真实人物身份"
          },
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "topic": {
            "type": "string",
            "enum": [
              "game",
              "reading",
              "study",
              "work",
              "daily"
            ],
            "description": "可选主题标签，不改变人物或会话授权范围"
          }
        },
        "required": [
          "messageId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "qq_social_memory_read",
      "description": "按索引编号读取获准正文；不能读取遗忘或过期资料。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "messageId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "当前会话收到的原消息 messageId/seq，绑定真实人物身份"
          },
          "memoryId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "messageId",
          "memoryId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "qq_social_memory_remember",
      "description": "记录当前消息有依据的日常事实、偏好或印象（kind=experience、confirmed=false）；只保存一件事。confirmed=true仅在正文与本人明确自述逐字一致且通过规则时生效，其他内容自动降为待核实。相同人物/会话/类型的归一化重复保留多条来源，不做同义推断。可给出逐字evidence；禁止指令或敏感凭据。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "messageId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "当前会话收到的原消息 messageId/seq，绑定真实人物身份"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "preference",
              "experience",
              "group_event"
            ]
          },
          "confirmed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "可选逐字证据，必须出自messageId对应原消息"
          }
        },
        "required": [
          "messageId",
          "content"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "qq_social_memory_forget",
      "description": "遗忘当前获准会话中的指定记忆，关联索引同步删除。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "messageId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "当前会话收到的原消息 messageId/seq，绑定真实人物身份"
          },
          "memoryId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "messageId",
          "memoryId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "qq_social_relationship_event",
      "description": "绑定原消息的关系事件；优先随qq_send_message.socialEvents提交。banter_preference只接收本人明确互损偏好，resolve_conflict需明确和好；不改变信任分数。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "messageId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "当前会话收到的原消息 messageId/seq，绑定真实人物身份"
          },
          "kind": {
            "type": "string",
            "enum": [
              "greeting",
              "positive_chat",
              "shared_activity",
              "support",
              "deep_talk",
              "conflict",
              "boundary_violation",
              "banter",
              "annoyed",
              "repair",
              "serious",
              "banter_preference",
              "resolve_conflict"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "memoryId": {
            "type": "string"
          },
          "preference": {
            "type": "string",
            "enum": [
              "light",
              "mutual",
              "stop"
            ]
          }
        },
        "required": [
          "messageId",
          "evidence",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "qq_social_memory_profile",
      "description": "按真实消息作者和当前授权会话生成有来源的人物资料摘录：最多3条已确认资料和1条未确认观察，每条100字。按需调用，不增加关系分数，不调用额外模型；观察不是事实或性格定论。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "messageId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "当前会话收到的原消息 messageId/seq，绑定真实人物身份"
          },
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "topic": {
            "type": "string",
            "enum": [
              "game",
              "reading",
              "study",
              "work",
              "daily"
            ],
            "description": "可选主题标签，不改变人物或会话授权范围"
          }
        },
        "required": [
          "messageId"
        ],
        "additionalProperties": false
      }
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "autoCapture": {
        "type": "boolean",
        "default": true,
        "description": "收到获准人物的明确本人事实/偏好时自动逐字保存，附原消息证据；不会从玩笑/转述/指令猜测事实"
      },
      "captureGroupSpeakers": {
        "type": "boolean",
        "default": false,
        "description": "管理员开启后，允许为白名单群内真实收到发言的QQ建档；不会增加私聊准入或读取其他群"
      },
      "people": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[1-9][0-9]{4,11}$"
        },
        "default": [],
        "description": "额外允许建档的人物QQ号；默认只用私聊白名单和管理员"
      },
      "enabled": {
        "type": "boolean"
      },
      "minimumTiers": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "enum": [
            "亲近",
            "深交"
          ]
        },
        "description": "管理员指定的QQ账号档位保底；仅调整对外相处档位，不伪造历史互动分数"
      }
    }
  }
}
